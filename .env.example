# Every variable the package reads. tests/test_env_example.py derives the list
# from the source, so a new one cannot be added without appearing here.

# --- Serving layer (rag_llm_infra.serve) ---
# Required. /index and /query answer 503 until this is set; there is no open mode.
RAG_API_KEY=
# RAG_MAX_BODY_BYTES=1048576     # 1 MiB. Bodies above it are refused with 413.
# RAG_MAX_CORPUS_DOCS=20000      # each document costs a fixed-width vector.

# --- LLM backend ---
OPENAI_API_KEY=
# OPENAI_MODEL_MAIN=gpt-4o       # the model name llm_call records when none is passed

# --- Vector store (optional) ---
# QDRANT_URL=                    # managed Qdrant endpoint; unset -> embedded :memory:

# --- Observability (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4317 ; unset -> console exporter
# OTEL_SERVICE_NAME=rag-llm-service

# --- Embedding engine (optional) ---
# EVIDENCE_MAX_CACHE=2000
# EVIDENCE_ADAPTIVE_CACHE=true   # inert unless the [psutil] extra is installed
# EVIDENCE_MEMORY_WARN=0.8       # fraction of system memory that counts as pressure
# EVIDENCE_EMBEDDING_REVISION=main   # pin to a commit SHA for reproducible loads
# DISABLE_SENTENCE_TRANSFORMERS=1    # force the import-guarded fallback path

# --- Logging ---
# ENV=dev                        # set to "prod" for single-line JSON logs
